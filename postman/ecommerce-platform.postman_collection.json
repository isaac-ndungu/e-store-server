{
  "info": {
    "_postman_id": "ecommerce-platform-step0",
    "name": "E-Commerce Platform (e-store)",
    "description": "API collection for the e-commerce backend, organized by application area — infrastructure, then one folder per app. Currently only infrastructure and core/site-config endpoints exist.\n\nCollection variables below (baseUrl, tokens, test phones) stand in for a separate environment — set them once when importing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "apiVersion",
      "value": "v1",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testPhone",
      "value": "254700000000",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "testMpesaPhone",
      "value": "254708374149",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Infrastructure — Health checks",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness/readiness probe — confirms the backend is reachable before any app-specific endpoint exists."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Core — Site Config",
      "item": [
        {
          "name": "Get site configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/site-config/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "site-config"]
            },
            "description": "Public site configuration for the storefront — branding, theme, currency/payment settings, and the standard VAT rate. Confirms the SiteConfig singleton is created on first request and returns its defaults."
          },
          "response": []
        },
        {
          "name": "Get legal / trust information",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/site-config/legal/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "site-config", "legal"]
            },
            "description": "Legal and trust copy — KRA PIN, business registration number, physical address, return policy, and cooling-off period. Confirms only legal fields are returned (theme/settings omitted)."
          },
          "response": []
        }
      ]
    }
  ]
}
