# Copy to .env and fill in. Never commit the real .env.
# Each section names where the value comes from so it can be filled in
# without guessing. Empty = use the local-dev default / leave disabled.

# --- Django core ---
# Generate a long random string for production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
DEBUG=True
SECRET_KEY=change-me-in-production
# Comma-separated hostnames the API serves, e.g. api.example.com. Ignored when DEBUG=True.
ALLOWED_HOSTS=*

# --- Frontend integration ---
# Public URL of the storefront (used for password-reset links and CORS examples).
# Local dev default is the common Vite/Next port; set to https://shop.example.com in production.
FRONTEND_URL=http://localhost:3000
# Where password-reset emails link to. Must be a page on FRONTEND_URL that reads <uid>/<token>/ from the path.
RESET_LINK_BASE=http://localhost:3000/reset/
# Comma-separated origins allowed to call the API from a browser, e.g.
# http://localhost:3000,https://shop.example.com,https://admin.example.com
# Leave empty in local dev if the frontend proxies /api to Django; set it as soon
# as the storefront runs on a different origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Set True only if the frontend sends cookies/sessions cross-origin. JWT Bearer auth does not need this.
CORS_ALLOW_CREDENTIALS=False
# Comma-separated trusted origins for cookie-based session flows (e.g. Django admin
# behind the storefront domain), e.g. https://api.example.com,https://admin.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database — PostgreSQL is the only database. ---
# Empty DB_HOST/DB_PORT use the local Unix socket / peer auth (no password for
# local dev). Set them plus DB_PASSWORD for a TCP/cloud connection.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=e_store_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Redis / Celery ---
# REDIS_URL is the general-purpose handle (scripts, ops tooling). CACHE_* and
# CELERY_* are what Django itself reads; keep them on the same Redis in dev.
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Reverse proxy ---
# Number of trusted reverse proxies in front of Django. Used when extracting the
# client IP for rate limiting. Keep 0 when no proxy rewrites the header chain.
NUM_PROXIES=0

# --- Email (SMTP) ---
# EMAIL_BACKEND defaults to console output in dev and in-memory during tests.
# For real delivery set e.g. django.core.mail.backends.smtp.EmailBackend plus the host vars.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@estore.local

# --- Assisted-sales hand-off (WhatsApp / email checkout). ---
# Public WhatsApp number customers message, in international format without
# the leading '+', e.g. 254712345678. Mirrored on SiteConfig.whatsapp_number.
WHATSAPP_BUSINESS_NUMBER=
# Mailbox that receives customer order emails. Mirrored on
# SiteConfig.order_intake_email.
ORDER_INTAKE_EMAIL=

# --- SMS provider — Africa's Talking by default. ---
# SMS_PROVIDER selects the provider module; AT_USERNAME/AT_API_KEY authenticate
# to it; SMS_SENDER_ID is the alphanumeric sender ID shown to recipients.
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=
SMS_SENDER_ID=

# --- SMS delivery-report callback trust (Africa's Talking POSTs reports here). ---
# Restrict to Africa's Talking egress IPs in production; leave empty in local
# dev to allow all. The shared secret is appended to the callback URL as a
# query param and the view rejects requests without it — set it in production
# so callback trust does not rest on the source IP alone.
NOTIFICATIONS_CALLBACK_IPS=
NOTIFICATIONS_CALLBACK_SECRET=

# --- M-Pesa / Daraja API — STK Push (Lipa Na M-Pesa Online) and B2C payouts. ---
# Obtain credentials from the Safaricom Developer Portal.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# Public-facing callback URLs that Safaricom will POST back to. These must
# be HTTPS and reachable from the internet (use ngrok for local dev).
MPESA_CALLBACK_URL=
MPESA_B2C_CALLBACK_URL=
MPESA_TIMEOUT_URL=
MPESA_RESULT_URL=
# IP allowlist for inbound Daraja callbacks — comma-separated. Leave empty
# in local dev to allow all IPs; in production restrict to Safaricom ranges.
MPESA_CALLBACK_IPS=196.201.214.200,196.201.214.201,196.201.214.202,196.201.214.203
# Shared secret appended to the Daraja callback URLs as a query param. The
# callback views reject requests without it, so callback trust doesn't rest on
# the source IP alone. Leave empty in local dev.
MPESA_CALLBACK_SECRET=
# Set to the production URL when going live.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke

# --- CDN / object storage (used in production for static/media). ---
CDN_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# --- Error tracking. Leave empty in local dev; set the DSN in staging/production. ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Test suite ---
# Run the test suite against the configured PostgreSQL database instead of the
# default in-memory SQLite. Required for the concurrency tests that exercise
# row-locking reservation/callback behavior; set in CI.
TEST_USE_POSTGRES=False
