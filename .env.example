# Copy to .env and fill in. Never commit the real .env.
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*

# Database — PostgreSQL is the only database. Empty DB_HOST/DB_PORT use the
# local Unix socket / peer auth (no password for local dev). Set them plus
# DB_PASSWORD for a TCP/cloud connection.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=e_store_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS — origins allowed to call the API (storefront + admin dashboard).
CORS_ALLOWED_ORIGINS=

# Number of trusted reverse proxies in front of Django. Makes DRF compute the
# client IP from the last hop it can trust when extracting identities for rate
# limiting, so a caller cannot spoof X-Forwarded-For to rotate past a throttle.
# Keep 0 when no proxy rewrites/forwards the header chain.
NUM_PROXIES=0

# SMS provider — Africa's Talking by default. SMS_PROVIDER selects the
# provider module; AT_USERNAME/AT_API_KEY authenticate to it; SMS_SENDER_ID
# is the alphanumeric sender ID shown to recipients.
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=
SMS_SENDER_ID=

# M-Pesa / Daraja API — STK Push (Lipa Na M-Pesa Online) and B2C payouts.
# Obtain credentials from the Safaricom Developer Portal.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# Public-facing callback URLs that Safaricom will POST back to.  These must
# be HTTPS and reachable from the internet (use ngrok for local dev).
MPESA_CALLBACK_URL=
MPESA_B2C_CALLBACK_URL=
MPESA_TIMEOUT_URL=
MPESA_RESULT_URL=
# IP allowlist for inbound Daraja callbacks — comma-separated.  Leave empty
# in local dev to allow all IPs; in production restrict to Safaricom ranges.
MPESA_CALLBACK_IPS=196.201.214.200,196.201.214.201,196.201.214.202,196.201.214.203
# Shared secret appended to the Daraja callback URLs as a query param.  The
# callback views reject requests without it, so callback trust doesn't rest on
# the source IP alone.  Leave empty in local dev.
MPESA_CALLBACK_SECRET=
# Set to the production URL when going live.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke

# CDN / object storage placeholders (activated in a later step / prod).
CDN_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
